{
  "name": "@local/dsh-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "静态资料库插件：自定义分区、文件导入与 LLM 转化、会话级绑定与「资料库优先」回答策略。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
