{
  "name": "dsh-static-kb",
  "version": "0.8.1",
  "description": "DeepSeek Harness 静态知识库：自定义分区、导入 PDF/网页/TXT/电子书并由模型转化为可检索 Markdown，按对话绑定、资料库优先回答。",
  "license": "MIT",
  "author": "Charlie <3032085943@qq.com>",
  "homepage": "https://github.com/Charlie-yangjiaqi/dsh-static-kb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charlie-yangjiaqi/dsh-static-kb.git"
  },
  "bugs": {
    "url": "https://github.com/Charlie-yangjiaqi/dsh-static-kb/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "static-site",
    "rag",
    "retrieval",
    "pdf",
    "markdown",
    "local-first"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:market": "node scripts/build-market-index.mjs",
    "check:market": "node scripts/validate-market-index.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4"
  },
  "dependencies": {
    "pdfjs-dist": "~6.4.299",
    "pdf-to-png-converter": "^4.3.0"
  }
}
